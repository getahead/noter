            "text": {
              "type": "string"
            }
          },
          "required": [
            "segment_id",
            "t0_ms",
            "speaker",
            "lang",
            "text"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
