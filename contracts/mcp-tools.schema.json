    "output": {
      "$defs": {
        "ScreenChip": {
          "properties": {
            "app": {
              "type": "string"
            },
            "at": {
              "$ref": "#/$defs/TimestampMs"
            },
            "label": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "label",
            "app",
            "at",
            "text"
          ],
          "type": "object"
        },
        "TimestampMs": {
          "description": "Milliseconds since the Unix epoch (UTC). Exported to TypeScript as `number`\n(exact up to the year 285 616).",
          "format": "int64",
          "type": "integer"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
