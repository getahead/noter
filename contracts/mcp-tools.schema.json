        },
        "entity": {
          "description": "\"segment\" | \"item\" | \"speaker\" | \"glossary\"",
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "evidence_segment_ids": {
          "items": {
            "$ref": "#/$defs/SegmentId"
          },
          "type": "array"
        },
        "field": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "entity",
        "entity_id",
        "field",
        "before",
        "after",
        "reason",
        "evidence_segment_ids"
      ],
      "title": "ProposeCorrectionInput",
      "type": "object"
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "reference": {
          "type": "string"
        },
        "staged": {
          "description": "Staged for the user's review; nothing changed yet.",
          "type": "boolean"
        }
      },
      "required": [
        "staged",
        "reference"
      ],
      "title": "StagedOutput",
      "type": "object"
    }
  },
  "search_calls": {
    "input": {
      "$defs": {
        "CallTypeId": {
          "description": "A call type, such as `one_on_one`, `planning` or a user-added type.\nCall types are data, not code: each one is a skill directory\n(`skills/<type>/`) and the list comes from `settings_call_types`.",
          "type": "string"
        },
        "Lang": {
          "description": "Content language. Detection is restricted to these three (PRD › Transcription pipeline).",
          "enum": [
            "en",
            "ru",
            "de"
          ],
          "type": "string"
        },
        "LocalDate": {
          "description": "A calendar date without time zone, `YYYY-MM-DD`, in the user's local calendar.",
          "type": "string"
        },
        "McpCallFilter": {
          "properties": {
            "call_types": {
              "default": [],
              "items": {
                "$ref": "#/$defs/CallTypeId"
              },
              "type": "array"
            },
            "from": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LocalDate"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "languages": {
              "default": [],
              "items": {
                "$ref": "#/$defs/Lang"
              },
              "type": "array"
            },
            "people": {
              "default": [],
              "items": {
                "$ref": "#/$defs/PersonId"
              },
              "type": "array"
            },
            "to": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LocalDate"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "type": "object"
        },
        "PersonId": {
          "description": "Opaque identifier: a core-generated ULID with a type prefix (see `PREFIX`); the UI never parses it.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "filter": {
          "$ref": "#/$defs/McpCallFilter",
          "default": {
            "call_types": [],
            "from": null,
            "languages": [],
            "people": [],
            "to": null
          }
        },
        "k": {
          "description": "Default 8, maximum 30.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "SearchCallsInput",
      "type": "object"
    },
    "output": {
      "$defs": {
        "CallHit": {
          "properties": {
            "call_date": {
              "$ref": "#/$defs/LocalDate"
            },
            "call_id": {
              "$ref": "#/$defs/CallId"
            },
            "call_title": {
              "type": "string"
            },
            "segment_ids": {
              "description": "Speaker-prefixed lines (\"Anna: …\"); cite these ids as evidence.",
              "items": {
                "$ref": "#/$defs/SegmentId"
              },
              "type": "array"
            },
            "strong": {
              "type": "boolean"
            },
            "t0_ms": {
              "$ref": "#/$defs/OffsetMs"
            },
            "t1_ms": {
              "$ref": "#/$defs/OffsetMs"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "call_id",
            "call_title",
            "call_date",
            "t0_ms",
            "t1_ms",
            "segment_ids",
            "text",
            "strong"
          ],
          "type": "object"
        },
        "CallId": {
          "description": "Opaque identifier: a core-generated ULID with a type prefix (see `PREFIX`); the UI never parses it.",
          "type": "string"
        },
        "LocalDate": {
          "description": "A calendar date without time zone, `YYYY-MM-DD`, in the user's local calendar.",
          "type": "string"
        },
        "OffsetMs": {
          "description": "Milliseconds from the start of a call (session-relative audio time).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "SegmentId": {
          "description": "Opaque identifier: a core-generated ULID with a type prefix (see `PREFIX`); the UI never parses it.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "hits": {
          "items": {
            "$ref": "#/$defs/CallHit"
          },
          "type": "array"
        },
        "keyword_only": {
          "type": "boolean"
        }
      },
      "required": [
        "hits",
        "keyword_only"
      ],
      "title": "SearchCallsOutput",
      "type": "object"
    }
  },
  "search_documents": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "k": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "title": "SearchDocumentsInput",
      "type": "object"
    },
    "output": {
      "$defs": {
        "ChunkId": {
          "description": "Opaque identifier: a core-generated ULID with a type prefix (see `PREFIX`); the UI never parses it.",
          "type": "string"
        },
        "DocumentHit": {
          "properties": {
            "chunk_id": {
              "$ref": "#/$defs/ChunkId"
            },
            "document_id": {
              "$ref": "#/$defs/DocumentId"
            },
            "heading_path": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "source_name": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "document_id",
            "chunk_id",
            "title",
            "heading_path",
            "source_name",
            "text"
          ],
          "type": "object"
        },
        "DocumentId": {
          "description": "Opaque identifier: a core-generated ULID with a type prefix (see `PREFIX`); the UI never parses it.",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "hits": {
          "items": {
            "$ref": "#/$defs/DocumentHit"
          },
          "type": "array"
        },
        "sensitive_skipped": {
          "description": "Sensitive sources are never returned to a cloud runtime.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "hits",
        "sensitive_skipped"
      ],
      "title": "SearchDocumentsOutput",
      "type": "object"
    }
  }
}
