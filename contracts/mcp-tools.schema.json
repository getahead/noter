{
  "$socket": {
    "request": {
      "$defs": {
        "CallId": {
          "description": "Opaque identifier: a core-generated ULID with a type prefix (see `PREFIX`); the UI never parses it.",
          "type": "string"
        },
        "McpRunContext": {
          "description": "Context the core binds to a runtime it spawned. noter-mcp reads\n`NOTER_MCP_TOKEN` from its environment and sends it with every request;\nthe core rejects any other connection.",
          "properties": {
            "call_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CallId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cloud": {
              "description": "Cloud runtimes never receive sensitive sources or sensitive calls.",
              "type": "boolean"
            },
            "llm_run_id": {
              "description": "The `llm_runs` row this session belongs to.",
              "type": "string"
            },
            "token": {
              "type": "string"
            }
          },
          "required": [
            "token",
            "llm_run_id",
            "cloud"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "JSON-RPC 2.0 request on the Unix socket: `method` is the tool name.",
      "properties": {
        "context": {
          "$ref": "#/$defs/McpRunContext"
        },
        "id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "jsonrpc": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "params": true
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "context",
        "params"
      ],
      "title": "CoreSocketRequest",
      "type": "object"
    },
    "response": {
      "$defs": {
        "CoreSocketError": {
          "properties": {
            "code": {
              "description": "-32602 invalid params, -32001 not allowed for this runtime, -32002 not found, -32603 internal.",
              "format": "int32",
              "type": "integer"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoreSocketError"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "jsonrpc": {
          "type": "string"
        },
        "result": true
      },
      "required": [
        "jsonrpc",
        "id"
      ],
      "title": "CoreSocketResponse",
      "type": "object"
    }
  },
  "emit_card": {
    "input": {
      "$defs": {
        "CandidateKind": {
          "enum": [
            "ask",
            "answer",
            "context",
            "pin",
            "catch_up"
          ],
          "type": "string"
        },
        "CardCandidate": {
          "description": "One card a council agent proposes in a tick. The core validates, merges,\nranks and drops; nothing here is shown as is.",
          "properties": {
            "agent": {
              "description": "Agent id from the packet (fused mode returns cards tagged by agent).",
              "type": "string"
            },
            "body": {
              "description": "At most two sentences.",
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "description": "0..1; the ranker drops anything below 0.6.",
              "format": "float",
              "type": "number"
            },
            "evidence_chunk_ids": {
              "items": {
                "$ref": "#/$defs/ChunkId"
              },
              "type": "array"
            },
            "evidence_segment_ids": {
              "items": {
                "$ref": "#/$defs/SegmentId"
              },
              "type": "array"
            },
            "jira_key": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "$ref": "#/$defs/CandidateKind"
            },
            "lang": {
              "$ref": "#/$defs/Lang"
            },
            "reason": {
              "description": "Why now, in one line (logged, not shown).",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/SourceKindHint"
            },
            "title": {
              "description": "One line, at most 120 characters; never a script to read aloud.",
              "type": "string"
            }
          },
          "required": [
            "agent",
            "kind",
            "title",
            "source",
            "evidence_segment_ids",
            "evidence_chunk_ids",
            "confidence",
            "reason",
            "lang"
          ],
          "type": "object"
        },
        "ChunkId": {
          "description": "Opaque identifier: a core-generated ULID with a type prefix (see `PREFIX`); the UI never parses it.",
          "type": "string"
        },
        "Lang": {
          "description": "Content language. Detection is restricted to these three (PRD › Transcription pipeline).",
          "enum": [
            "en",
            "ru",
            "de"
          ],
          "type": "string"
        },
        "SegmentId": {
          "description": "Opaque identifier: a core-generated ULID with a type prefix (see `PREFIX`); the UI never parses it.",
          "type": "string"
        },
        "SourceKindHint": {
          "enum": [
            "this_call",
            "past_call",
            "jira",
            "document",
            "model_guess"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "card": {
          "$ref": "#/$defs/CardCandidate"
        }
      },
      "required": [
        "card"
      ],
      "title": "EmitCardInput",
      "type": "object"
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "reference": {
          "type": "string"
        },
        "staged": {
          "description": "Staged for the user's review; nothing changed yet.",
          "type": "boolean"
        }
      },
      "required": [
        "staged",
        "reference"
      ],
      "title": "StagedOutput",
      "type": "object"
    }
  },
  "get_decisions": {
