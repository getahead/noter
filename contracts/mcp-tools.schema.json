      "title": "ScreenContextOutput",
      "type": "object"
    }
  },
  "get_transcript_span": {
    "input": {
      "$defs": {
        "AudioChannel": {
          "description": "The two capture channels, kept separate end to end.",
          "oneOf": [
            {
              "const": "mic",
              "description": "The user's microphone (\"you\").",
              "type": "string"
            },
            {
              "const": "sys",
              "description": "System audio: everyone else.",
              "type": "string"
            }
          ]
        },
        "CallId": {
          "description": "Opaque identifier: a core-generated ULID with a type prefix (see `PREFIX`); the UI never parses it.",
          "type": "string"
        },
        "OffsetMs": {
          "description": "Milliseconds from the start of a call (session-relative audio time).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "call_id": {
          "$ref": "#/$defs/CallId"
        },
        "channel": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioChannel"
            },
            {
              "type": "null"
            }
          ]
        },
        "t0_ms": {
          "$ref": "#/$defs/OffsetMs"
        },
        "t1_ms": {
          "$ref": "#/$defs/OffsetMs"
        }
      },
      "required": [
        "call_id",
        "t0_ms",
        "t1_ms"
      ],
      "title": "GetTranscriptSpanInput",
      "type": "object"
    },
    "output": {
      "$defs": {
        "Lang": {
          "description": "Content language. Detection is restricted to these three (PRD › Transcription pipeline).",
          "enum": [
            "en",
            "ru",
            "de"
          ],
          "type": "string"
        },
        "OffsetMs": {
          "description": "Milliseconds from the start of a call (session-relative audio time).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "SegmentId": {
          "description": "Opaque identifier: a core-generated ULID with a type prefix (see `PREFIX`); the UI never parses it.",
          "type": "string"
        },
        "SpanLine": {
          "properties": {
