<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>ai.noter.engine</string>
    <key>CFBundleName</key>
    <string>Noter Engine</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Noter records your side of the call to transcribe it on this Mac.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Noter records the other people on the call to transcribe them on this Mac.</string>
</dict>
</plist>
