<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The engine's own entitlements (cpt-noter-constraint-core-engine-offline): audio input under
     the hardened runtime. No App Sandbox and no App Group (ADR-0004: ad-hoc signed releases cannot
     use a group container); it shares ~/Library/Application Support/Noter with the app. No network
     entitlement, ever; `just arch` fails on one. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
