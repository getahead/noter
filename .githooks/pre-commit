#!/usr/bin/env bash
# Noter pre-commit (installed by `just setup`): the lane guard over staged files,
# for every tool and every agent, plus formatting of staged Rust.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
# GUI clients and agent shells may start without the login PATH: find rustup's cargo and
# a Python 3.11+ (the gate scripts need tomllib; macOS's /usr/bin/python3 is older).
export PATH="$PATH:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin"
py=
for c in python3 python3.14 python3.13 python3.12 python3.11; do
  if command -v "$c" >/dev/null && "$c" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then py=$c; break; fi
done
[ -n "$py" ] || { echo "pre-commit: the lane guard needs Python 3.11+ (brew install python@3.12)"; exit 1; }
"$py" "$root/scripts/harness/lane_guard.py" staged
if git diff --cached --name-only --diff-filter=ACM | grep -q '\.rs$'; then
  cargo fmt --all -- --check >/dev/null 2>&1 || { echo "pre-commit: run 'just fmt' (Rust formatting)"; exit 1; }
fi
