<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's entitlements under the hardened runtime. No App Group (ADR-0004): releases are
     ad-hoc signed, so app, core and engine share ~/Library/Application Support/Noter. -->
<plist version="1.0">
<dict>
    <!-- @cpt-dod:cpt-noter-dod-core-first-run-permissions:p1 -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- Handoff's terminal fallback drives Terminal or iTerm with Apple Events (hardened runtime). -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
