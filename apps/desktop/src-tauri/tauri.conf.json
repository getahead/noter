{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noter",
  "version": "../package.json",
  "identifier": "com.getahead.noter",
  "build": {
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm exec vite build && TEAM_ID=${APPLE_TEAM_ID:-TEAMID} SIGN_IDENTITY=${APPLE_SIGNING_IDENTITY:--} ../../engine/scripts/sign.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Noter",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "entitlements": "Noter.entitlements",
      "files": {
        "MacOS/noter-engine": "../../../engine/.build/release/noter-engine"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
