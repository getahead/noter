{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noter",
  "version": "0.2.0",
  "identifier": "com.getahead.noter",
  "build": {
    "frontendDist": "placeholder"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Noter", "width": 1200, "height": 800 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "macOS": { "entitlements": "Noter.entitlements" } }
}
